# Copie este arquivo para ".env" se quiser configurar valores fixos
# localmente (opcional — sem ele, o servidor gera credenciais sozinho na
# primeira execução, veja o README). Ao publicar em produção, configure
# estas variáveis no painel do seu serviço de hospedagem (ex: Render),
# não neste arquivo.

# Porta em que o servidor backend escuta.
PORT=3001

# Segredo usado para assinar os tokens de login (JWT). Se não definido,
# um valor aleatório é gerado e salvo em server/.jwt-secret.
JWT_SECRET=

# Credenciais do painel admin. Se não definidas, uma senha aleatória é
# gerada na primeira execução e mostrada uma única vez no terminal.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Restringe quais sites podem chamar a API (separado por vírgula).
# Sem isso: em desenvolvimento, qualquer origem é permitida; em produção
# (NODE_ENV=production), só a origem do próprio site (SITE_URL e/ou
# RENDER_EXTERNAL_URL).
# Exemplo: ALLOWED_ORIGINS=https://seu-app.onrender.com
ALLOWED_ORIGINS=

# Pasta com TODOS os dados mutáveis: banco (deckbuilder.db), segredos
# gerados, cartas editáveis (cards/modelo_cartas.json), imagens de cartas e
# avatares enviados (assets/) e backups (backups/). Sem isso, usa a pasta
# server/. No Render, é o disco persistente montado em /data.
# DATA_DIR=/data

# Quantos proxies confiar para descobrir o IP real do cliente (rate limit).
# Padrão: 1 em produção, nenhum em desenvolvimento. Aceita número, true/false
# ou lista de IPs/sub-redes do Express (ex: "loopback, 10.0.0.0/8").
# TRUST_PROXY=1

# Backups automáticos do banco em DATA_DIR/backups (ligado por padrão,
# desligado com NODE_ENV=test). Intervalo em horas (0 desliga) e quantos
# snapshots manter.
# BACKUP_ENABLED=true
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=7

# Janela (ms) para agrupar as gravações do banco em disco. Padrão: 250.
# DB_SAVE_DELAY_MS=250


# ============================================================
# E-mail (recuperacao de senha) — Fase 5
# ============================================================
# Sem EMAIL_PROVIDER: o servidor NAO envia e-mail de verdade; ele imprime
# o conteudo (incluindo o link de recuperacao) no console. Isso permite
# testar o fluxo inteiro localmente sem servico externo.
#
# Para enviar de verdade em producao, use o Resend (https://resend.com):
#   EMAIL_PROVIDER=resend
#   RESEND_API_KEY=sua_chave_aqui
#   EMAIL_FROM="Forja de Alter Egos <no-reply@seudominio.com>"
#
# O Resend so aceita remetente de um dominio que voce verificou no painel
# dele. Para um teste rapido, use EMAIL_FROM=onboarding@resend.dev (nesse
# modo ele so entrega para o e-mail da sua propria conta no Resend).
# Ao subir o servidor, ele avisa no terminal se faltar alguma configuracao.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=

# URL base do site, usada para montar o link de recuperacao de senha.
# Em dev: http://localhost:5173. No Render, se nao definir, o servidor usa
# o endereco publico do servico (RENDER_EXTERNAL_URL) automaticamente.
# Este arquivo (.env) e lido pelo servidor ao iniciar; nao o envie ao Git.
SITE_URL=http://localhost:5173
